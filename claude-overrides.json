{
  "skills": {},
  "settings": {
    "cleanupPeriodDays": 9999,
    "model": null,
    "effortLevel": "high",
    "modelSettings": {
      "opus": {
        "effortLevel": "medium"
      },
      "fable": {
        "effortLevel": "medium"
      },
      "claude-opus-5": null,
      "claude-fable-5-1": null,
      "claude-fable-5-2": null,
      "claude-sonnet-5": null,
      "claude-haiku-4-5": null
    },
    "tui": "fullscreen",
    "theme": "dark",
    "autoMemoryEnabled": false,
    "skipWorkflowUsageWarning": true,
    "remoteControlAtStartup": false,
    "agentPushNotifEnabled": true,
    "permissions": {
      "defaultMode": "auto",
      "allow": [
        "Bash(agent-browser:*)",
        "Bash(archon:*)",
        "Bash(bd:*)",
        "Bash(cat:*)",
        "Bash(clickup:*)",
        "Bash(gh:*)",
        "Bash(git:*)",
        "Bash(graphiti:*)",
        "Bash(grep:*)",
        "Bash(jq:*)",
        "Bash(ls:*)",
        "Bash(mise:*)",
        "Bash(mkdir:*)",
        "Bash(obsidian:*)",
        "Bash(rtk:*)",
        "Bash(uvx mcp2cli:*)",
        "Bash(vitrine:*)",
        "LSP",
        "Skill",
        "WebSearch",
        "mcp__plugin_context7_context7__*",
        "!mcp__plugin_context7-plugin_context7__*",
        "!mcp__plugin_context7__*"
      ],
      "ask": null,
      "deny": [
        "WebFetch(domain:github.com)",
        "Bash(curl *github.com*)",
        "Bash(wget *github.com*)",
        "Bash(bd remember:*)",
        "Bash(bd memories:*)",
        "!Bash(curl: *github.com*)",
        "!Bash(wget: *github.com*)"
      ]
    },
    "skillOverrides": {
      "build-dark-factory": "user-invocable-only"
    },
    "worktree": {
      "bgIsolation": "worktree"
    },
    "statusLine": {
      "type": "command",
      "command": "bash \"$HOME/.claude/statusline.sh\""
    },
    "env": {
      "ANTHROPIC_MODEL": "opus[1m]"
    },
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Edit|Write|MultiEdit|Bash",
          "hooks": [
            {
              "type": "command",
              "command": "$HOME/bin/exec/claude-config-guard-hook"
            }
          ]
        }
      ]
    },
    "autoMode": {
      "allow": [
        "$defaults",
        "ClickUp CLI: any `clickup`, `clickup-cli` or `clkup` command is allowed, including task updates, status changes, tags, comments and task creation, in any ClickUp workspace, without asking the user first. The clickup-guard hook already asks the user before the risky ones (deletes, removes, uploads, chat, invites, ACL and webhook changes), so do not block a clickup command as an External System Write."
      ],
      "soft_deny": "DRIFT_IGNORE",
      "environment": "DRIFT_IGNORE"
    }
  },
  "config": {
    "copyOnSelect": false
  },
  "seed": {
    "enabledPlugins": {
      "frontend-design@claude-plugins-official": true,
      "gideon@thecodedestroyer-plugins": true,
      "skill-creator@claude-plugins-official": true,
      "typescript-lsp@claude-plugins-official": true,
      "pyright-lsp@claude-plugins-official": true,
      "security-guidance@claude-plugins-official": true,
      "context7@context7-marketplace": true,
      "vitrine@spartan-plugins": true,
      "convex@spartan-plugins": true,
      "corvus@spartan-plugins": true,
      "git@spartan-plugins": true,
      "react@spartan-plugins": true,
      "node@spartan-plugins": true,
      "persona@claude-persona": true,
      "supermods@thecodedestroyer-plugins": true
    },
    "extraKnownMarketplaces": {
      "openai-codex": {
        "source": {
          "source": "github",
          "repo": "openai/codex-plugin-cc"
        }
      },
      "thecodedestroyer-plugins": {
        "source": {
          "source": "github",
          "repo": "TheCodeDestroyer/claude-code-plugins"
        }
      },
      "context7-marketplace": {
        "source": {
          "source": "github",
          "repo": "upstash/context7"
        }
      },
      "spartan-plugins": {
        "source": {
          "source": "github",
          "repo": "spartandevelopment0/claude-code-plugins"
        }
      },
      "claude-persona": {
        "source": {
          "source": "github",
          "repo": "TheCodeDestroyer/claude-persona"
        }
      }
    }
  }
}
