#!/usr/bin/env python3
"""claude-update - Update Claude Code marketplaces, plugins, and skills.

A marketplace refresh only advances the marketplace clone + catalog; it does NOT
re-pin installed plugins. Plugin versions are pinned in installed_plugins.json
and stay frozen until `claude plugin update <plugin>` rewrites them, so a
marketplace-only updater silently leaves plugins on stale versions.

This script: refreshes every marketplace, then updates every installed plugin
at its own scope, each step in parallel across all config homes
(CLAUDE_UPDATE_JOBS at once, default 10), and prints a per-home drift table
(old -> new). Plugin updates need a Claude Code restart to take effect, so the
table reflects what will be active after restart.

It then applies claude-overrides.json: the `skills` section re-patches SKILL.md
frontmatter, which `skills update` overwrites with upstream whenever upstream
moves that skill, and the `settings` section merges keys into each config
home's settings.json (lists union, "!<item>" removes a list item, null
deletes, "DRIFT_IGNORE" marks a key the home owns, machine-local keys survive),
the `seed` section writes settings.json keys only where a home lacks them,
and the `config` section merges the same way into each home's global config
(.claude.json). It also links each home's CLAUDE.md to claude-global.md, and
ends with a drift report: settings.json keys the overrides do not manage.
`--overrides-only` runs those steps alone; `--dry-run` previews them without
writing; `--drift` prints only the report.
"""
import argparse
import filecmp
import fnmatch
import json
import os
import shutil
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor
from functools import partial

DEFAULT_ROOT = os.path.expanduser("~/.claude")


def sh(cmd, root=None, timeout=600):
    """Run a command; return (returncode, stdout, stderr)."""
    env = dict(os.environ)
    if root:
        env["CLAUDE_CONFIG_DIR"] = root
    try:
        p = subprocess.run(
            cmd, env=env, capture_output=True, text=True, timeout=timeout
        )
        return p.returncode, p.stdout, p.stderr
    except subprocess.TimeoutExpired:
        return 124, "", f"timed out after {timeout}s"


def config_roots():
    """Every Claude config root: each logins.<name>.folder in
    claude-personas.json, else ~/.claude. Same function in claude-config-guard.
    """
    try:
        with open(PERSONAS_FILE) as f:
            logins = json.load(f)["logins"].values()
        return [os.path.expanduser(login["folder"]) for login in logins]
    except (OSError, ValueError, KeyError, TypeError):
        return [DEFAULT_ROOT]


def list_plugins(root):
    """Return {id: {"version": str, "scope": str}} for installed plugins."""
    rc, out, _ = sh(["claude", "plugin", "list", "--json"], root=root, timeout=120)
    if rc != 0 or not out.strip():
        return {}
    try:
        items = json.loads(out)
    except json.JSONDecodeError:
        return {}
    return {
        p["id"]: {"version": p.get("version", "?"), "scope": p.get("scope", "user")}
        for p in items
        if isinstance(p, dict) and "id" in p
    }


def marketplace_names(root):
    rc, out, _ = sh(["claude", "plugin", "marketplace", "list", "--json"],
                    root=root, timeout=120)
    try:
        return sorted(m["name"] for m in json.loads(out)) if rc == 0 else []
    except (ValueError, KeyError, TypeError):
        return []


def install_missing(root):
    """Add the marketplaces and install the plugins settings.json names but the
    root lacks; return (marketplace names, installed plugins) as they stand
    afterwards. A fresh machine gets both lists from the `seed` section, so run
    `claude-update --overrides-only` once before the first full run there."""
    try:
        with open(settings_file(root)) as f:
            settings = json.load(f)
    except (OSError, ValueError):
        settings = {}

    names, added = marketplace_names(root), False
    for name, entry in sorted((settings.get("extraKnownMarketplaces") or {}).items()):
        src = entry.get("source") or {}
        if name in names or src.get("source") != "github":
            continue
        rc, _, err = sh(["claude", "plugin", "marketplace", "add", src["repo"]], root=root)
        print(f"  Added marketplace {name}" if rc == 0
              else f"  Marketplace {name} failed: {err.strip() or rc}")
        added = added or rc == 0
    if added:
        names = marketplace_names(root)

    installed, added = list_plugins(root), False
    for pid in sorted(settings.get("enabledPlugins") or {}):
        if pid in installed:
            continue
        rc, _, err = sh(["claude", "plugin", "install", pid, "--scope", "user"],
                        root=root, timeout=300)
        print(f"  Installed {pid}" if rc == 0
              else f"  Install {pid} failed: {err.strip() or rc}")
        added = added or rc == 0
    if added:
        installed = list_plugins(root)
    return names, installed


def install_missing_skills():
    """Sync the global `skills` set with skills.json ({name: source}) in this
    repo: install what it lists but this machine lacks, then add what this
    machine has but it lacks. Not the lock itself: `skills` rewrites hashes and
    timestamps in the lock on every install or update, which would leave the
    repo dirty on every machine. Removing a skill means deleting it here too."""
    lock = os.path.expanduser("~/.agents/.skill-lock.json")
    try:
        with open(SKILLS_LIST_FILE) as f:
            wanted = json.load(f)
    except (OSError, ValueError):
        wanted = {}
    try:
        with open(lock) as f:
            local = {n: e["source"] for n, e in (json.load(f).get("skills") or {}).items()}
    except (OSError, ValueError, KeyError):
        local = {}

    for name, source in sorted(wanted.items()):
        if name in local and os.path.isdir(os.path.join(SKILLS_DIR, name)):
            continue
        # codex reads ~/.agents/skills itself, so naming it makes `skills` keep
        # the copy there and symlink it into ~/.claude/skills. With claude-code
        # alone it copies straight into ~/.claude/skills instead.
        rc = subprocess.run(
            ["npx", "--yes", "skills", "add", source, "-g",
             "-s", name, "-a", "claude-code", "codex", "-y"],
            stdin=subprocess.DEVNULL, capture_output=True, timeout=300,
        ).returncode
        print(f"  Installed skill {name}" if rc == 0
              else f"  Install skill {name} failed: rc={rc}")

    merged = dict(sorted({**local, **wanted}.items()))
    if merged != wanted:
        with open(SKILLS_LIST_FILE, "w") as f:
            json.dump(merged, f, indent=2)
            f.write("\n")
        added = sorted(set(merged) - set(wanted))
        print(f"  Added to {os.path.basename(SKILLS_LIST_FILE)}: {', '.join(added)}")


def update_cli():
    """Update the Claude Code binary itself. The native auto-updater only runs
    from inside a session, so a machine with no session open (or with the
    updater disabled) falls behind. Open sessions keep the old binary until
    restart."""
    print("\nUpdating Claude Code CLI...")
    rc, out, err = sh(["claude", "update"], timeout=300)
    last = (out.strip().splitlines() or ["done"])[-1]
    print(f"  {last}" if rc == 0 else f"  failed: {err.strip() or rc}")


# How many `claude` processes run at once. Each is a full CLI process, so keep
# this well below the plugin count.
JOBS = int(os.environ.get("CLAUDE_UPDATE_JOBS") or 10)


def run_all(jobs, fn):
    """Run fn(*job) for every job on JOBS threads; return results in job order."""
    with ThreadPoolExecutor(max_workers=JOBS) as pool:
        return list(pool.map(lambda job: fn(*job), jobs))


def last_json(out):
    """The last stdout line that parses as a JSON object, else {}."""
    for line in reversed(out.strip().splitlines()):
        try:
            value = json.loads(line)
        except ValueError:
            continue
        if isinstance(value, dict):
            return value
    return {}


def refresh_marketplace(root, name):
    """Refresh one marketplace; return None on success, else the error.

    One by name, not the bulk `marketplace update`: the bulk call refreshes
    them one after another (25s for 6, against 5s in parallel). The parallel
    runs share known_marketplaces.json, but a lost write there costs only its
    lastUpdated stamp, not the clone. The bulk call also refreshes the /plugin
    browse catalog (plugin-directory-cache-v2.json); a refresh by name does
    not, and Claude Code refreshes that catalog on its own.
    """
    rc, _, err = sh(["claude", "plugin", "marketplace", "update", name],
                    root=root, timeout=300)
    return None if rc == 0 else (err.strip() or f"rc={rc}")


def update_plugin(root, pid, scope):
    """Update one plugin; return (new_version_or_None, error_or_None)."""
    rc, out, err = sh(
        ["claude", "plugin", "update", pid, "--scope", scope, "--json"],
        root=root,
        timeout=300,
    )
    result = last_json(out)
    if rc != 0:
        return None, result.get("message") or err.strip() or f"rc={rc}"
    return result.get("newVersion"), None


def update_roots(roots):
    """Refresh every marketplace, then update every plugin, across all homes.

    Each phase runs as one parallel pool over all homes, so the slowest single
    git fetch sets the time, not the sum. Plugin updates in one home share
    installed_plugins.json, which Claude Code rewrites whole with no
    cross-process lock, so two updates that finish together can drop one
    version change. The repair pass re-runs, one at a time, every update whose
    reported version is not what `plugin list` shows afterwards.
    """
    homes, names, before = [], {}, {}
    for root in roots:
        print(f"\n=== {root} ===")
        if not os.path.isdir(root):
            print("  (no such config home, skipping)")
            continue
        homes.append(root)
        names[root], before[root] = install_missing(root)

    started = time.monotonic()
    jobs = [(root, name) for root in homes for name in names[root]]
    print(f"\nRefreshing {len(jobs)} marketplaces in {len(homes)} homes...")
    errors = run_all(jobs, refresh_marketplace)
    for (root, name), err in zip(jobs, errors):
        if err:
            print(f"  {name} ({root}) failed: {err}")
    print(f"  done in {time.monotonic() - started:.0f}s")

    started = time.monotonic()
    jobs = [(root, pid, info["scope"])
            for root in homes for pid, info in sorted(before[root].items())]
    print(f"\nUpdating {len(jobs)} plugins in {len(homes)} homes...")
    results = dict(zip(jobs, run_all(jobs, update_plugin)))
    after = dict(zip(homes, run_all([(r,) for r in homes], list_plugins)))

    lost = [job for job, (new, _) in results.items()
            if new and after[job[0]].get(job[1], {}).get("version") != new]
    if lost:
        print(f"  Repairing {len(lost)} lost version changes...")
        for job in lost:
            results[job] = update_plugin(*job)
        for root in {job[0] for job in lost}:
            after[root] = list_plugins(root)
    print(f"  done in {time.monotonic() - started:.0f}s")

    for root in homes:
        print(f"\n=== {root} ===")
        report_versions(before[root], after[root],
                        {pid: err for (r, pid, _), (_, err) in results.items()
                         if r == root and err})


def report_versions(before, after, failures):
    if not before:
        print("  No installed plugins found.")
        return
    changed = [
        (pid, before[pid]["version"], after.get(pid, {}).get("version", "?"),
         before[pid]["scope"])
        for pid in sorted(before)
        if before[pid]["version"] != after.get(pid, {}).get("version", before[pid]["version"])
    ]

    if changed:
        width = max(len(c[0]) for c in changed)
        print("  Version changes (apply on restart):")
        for pid, old, new, scope in changed:
            print(f"    {pid:<{width}}  {old} -> {new}  ({scope})")
    else:
        print("  All plugins already at latest pinned version.")

    if failures:
        print("  Update failures:")
        for pid, msg in sorted(failures.items()):
            print(f"    {pid}: {msg}")


# --- Claude Code overrides --------------------------------------------------
# claude-overrides.json is this repo's desired-state file for Claude Code:
# the config that should follow the dotfiles to any machine. It is split
# into sections by TARGET, because each target is patched differently.
#
#   skills   -> SKILL.md frontmatter in AGENT_SKILLS_DIR
#   settings -> keys merged into each config root's settings.json:
#               permissions, model, worktree, statusLine, skillOverrides, ...
#   seed     -> top-level settings.json keys written only when the root lacks
#               the key, then never touched again: enabledPlugins and
#               extraKnownMarketplaces. A fresh root starts with the full set;
#               after that each root installs/enables plugins on its own (the
#               work root deliberately runs a different plugin set).
#   config   -> keys merged into each config root's global config (.claude.json):
#               the /config toggles Claude Code reads only from there, such as
#               copyOnSelect. A copy in settings.json is silently ignored.
#
# The global config is $CLAUDE_CONFIG_DIR/.claude.json, or ~/.claude.json unset.
#
# Claude Code keeps the global config in memory and writes it back often, so a
# session that is open during a write can overwrite the change. Apply with no
# session open, or re-run after closing them.
#
# Invocation policy belongs in the settings section as `skillOverrides`, NOT in
# the skills section: it reaches the same outcome without patching the upstream
# SKILL.md, and the settings section makes it version-controlled here anyway.
# The skills section is only for frontmatter settings.json cannot express --
# description, model, allowed-tools.
#
# The skills and settings targets are NOT the same problem. Skill frontmatter needs
# re-applying because `skills update` overwrites the file; settings.json is
# never rewritten by an update, so a settings section would exist purely to
# version the config, and would have to MERGE (not replace) so machine-local
# keys survive.
#
# -- skills section ---------------------------------------------------------
# `skills update` re-fetches SKILL.md from upstream, so any local frontmatter
# edit (disable-model-invocation, a sharper description, allowed-tools) is
# clobbered whenever upstream moves that skill. The override config re-applies
# them afterwards. The npm skills live once in AGENT_SKILLS_DIR and are
# symlinked into each Claude config home, so patching the file there covers
# every home.
#
# Claude Code has a native lever for invocation policy: `skillOverrides` in
# ~/.claude/settings.json, which `/skills` writes for you (Space cycles
# on|name-only|user-invocable-only|off, Enter saves). It is never clobbered by
# an update and leaves the upstream file pristine. We deliberately do NOT use
# it as the source of truth, because ~/.claude/settings.json is not in this
# repo: an override set there is unversioned and does not survive a fresh
# machine. This config owns invocation policy instead, and the accepted cost is
# that the upstream SKILL.md is patched and so diverges from upstream.
# `skillOverrides` remains the better tool for a throwaway/machine-local tweak,
# and `name-only` drops an over-broad description from the listing without
# rewriting it. Neither lever reaches plugin skills -- the resolver returns
# "on" for anything whose source is a plugin (verified against Claude Code
# 2.1.237); manage those via /plugin.
#
# skills section format: {name-or-glob: {key: value}}; empty or absent is fine
# (prints "no skills section, skipping"). Note CLAUDE_CODE_MANAGED_SETTINGS_PATH is NOT a usable
# alternative: it is undocumented and, as of 2.1.237, a deny rule supplied
# through it is not enforced as either a file or a directory path, and a
# malformed file raises no error at all.

SKILLS_DIR = os.environ.get("AGENT_SKILLS_DIR") or os.path.expanduser(
    "~/.agents/skills"
)
REPO = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
SKILLS_LIST_FILE = os.path.join(REPO, "skills.json")
PERSONAS_FILE = os.path.join(REPO, "claude-personas.json")
OVERRIDES_FILE = os.environ.get("CLAUDE_OVERRIDES") or os.path.join(
    REPO, "claude-overrides.json"
)
_YAML_RESERVED = {"true", "false", "null", "yes", "no", "on", "off", "~"}


def yaml_scalar(value):
    """Render an override value as an inline YAML node, quoting when ambiguous.

    JSON is a subset of YAML, so json.dumps is both the renderer and the
    quoter: it yields `true`/`3` for scalars and flow style for a list or map.
    Plain strings stay unquoted when unambiguous, to keep the patched line
    readable and the diff against upstream as small as the change itself.
    """
    if not isinstance(value, str):
        return json.dumps(value)
    risky = (
        not value
        or value != value.strip()
        or value[0] in "-?:,[]{}#&*!|>'\"%@`"
        or ": " in value
        or value.endswith(":")
        or " #" in value
        or value.lower() in _YAML_RESERVED
        or any(ch < " " for ch in value)  # tabs/newlines: no plain scalar holds them
    )
    return json.dumps(value) if risky else value


def resolve_overrides(cfg, names):
    """Fold {name-or-glob: {key: value}} into {skill: {key: value}}.

    Entries apply in file order and later ones win, so a glob broadcasts a
    change across N skills and a literal name listed after it overrides that
    one skill. A literal name is just a glob with no metacharacters, so there
    is no separate per-skill tier to keep in sync.
    """
    resolved, warnings = {}, []
    for pattern, values in cfg.items():
        hits = fnmatch.filter(names, pattern)
        if not hits:
            warnings.append(f"'{pattern}' matched no installed skill")
        for name in hits:
            resolved.setdefault(name, {}).update(values)
    return resolved, warnings


def patch_frontmatter(path, values, dry_run=False):
    """Set top-level keys in a SKILL.md frontmatter block.

    Line-based on purpose: a real YAML round-trip would reflow descriptions and
    drop comments, i.e. a far bigger diff than the change we asked for. Returns
    (changes, error) where changes is a list of rendered lines that were (or,
    under dry_run, would be) written.
    """
    with open(path) as f:
        lines = f.read().split("\n")
    if lines[0].strip() != "---":
        return None, "no frontmatter"
    close = next(
        (i for i in range(1, len(lines)) if lines[i].strip() == "---"), None
    )
    if close is None:
        return None, "unterminated frontmatter"

    block = lines[1:close]
    changes = []
    # null means "this key should be absent" -- the revert path, since `skills
    # update` is a no-op when upstream has not moved and so will NOT restore a
    # file we patched. So deleting an entry is NOT a revert: the patch stays on
    # disk while `skills update -g <name>` reports "up to date". Set the key to
    # null, re-apply, then drop the entry. Verified 2026-08-20 (skills 1.5.21):
    # this restores the file byte-for-byte against the upstream blob.
    for key, value in values.items():
        start = next(
            (i for i, line in enumerate(block) if line.startswith(key + ":")), None
        )
        if start is None:
            if value is not None:
                block.append(f"{key}: {yaml_scalar(value)}")
                changes.append(("+", block[-1]))
            continue

        # A wrapped or nested value continues on the following indented lines.
        end = start + 1
        while end < len(block) and block[end][:1] in (" ", "\t"):
            end += 1

        if value is None:
            del block[start:end]
            changes.append(("-", key))
            continue

        rendered = f"{key}: {yaml_scalar(value)}"
        if block[start:end] != [rendered]:
            block[start:end] = [rendered]
            changes.append(("~", rendered))

    if changes and not dry_run:
        with open(path, "w") as f:
            f.write("\n".join([lines[0]] + block + lines[close:]))
    return changes, None


# A settings key a root owns on purpose is named in the settings section with
# this value in place of a real one. It is taken out of the section on load,
# so the merge never sees the key and leaves it as the root has it, and the
# drift report skips its dotted path. The key name is public; its content is not.
DRIFT_IGNORE = "DRIFT_IGNORE"


def split_drift_ignore(desired, path=""):
    """Split a settings mapping into (the values to merge, the dotted paths
    set to DRIFT_IGNORE)."""
    values, paths = {}, set()
    for key, want in desired.items():
        where = f"{path}.{key}" if path else key
        if want == DRIFT_IGNORE:
            paths.add(where)
        elif isinstance(want, dict):
            values[key], below = split_drift_ignore(want, where)
            paths |= below
        else:
            values[key] = want
    return values, paths


def load_override_doc():
    """Read the override file; return (doc, drift-ignore paths), or (None,
    set()). The doc's settings section comes back without its DRIFT_IGNORE
    keys. Warns about keys that are not sections."""
    if not os.path.isfile(OVERRIDES_FILE):
        print(f"  no override config at {OVERRIDES_FILE}, skipping")
        return None, set()
    try:
        with open(OVERRIDES_FILE) as f:
            doc = json.load(f)
    except (json.JSONDecodeError, OSError) as exc:
        print(f"  unreadable override config: {exc}")
        return None, set()
    # A key that is not a known section is almost certainly the pre-sections
    # flat format ({skill: {key: value}}), which would otherwise resolve to
    # nothing at all. Say so rather than silently no-op.
    unknown = [k for k in doc if k not in OVERRIDE_SECTIONS]
    if unknown:
        print(f"  warning: ignoring non-section key(s): {', '.join(sorted(unknown))}")
        print(f"  (expected top-level sections: {', '.join(OVERRIDE_SECTIONS)})")
    doc["settings"], ignore = split_drift_ignore(doc.get("settings") or {})
    return doc, ignore


def split_removals(items):
    """Split a desired list into (items to keep, items a "!<item>" removes)."""
    keep, drop = [], []
    for v in items:
        if isinstance(v, str) and v.startswith("!"):
            drop.append(v[1:])
        else:
            keep.append(v)
    return keep, drop


def merge_settings(current, desired, path=""):
    """Deep-merge desired into current, returning (merged, changes).

    Mappings recurse. Lists UNION (existing order kept, new appended) so a
    machine-local permission rule is never dropped by the shared config; a
    "!<item>" string in a list removes <item> instead, to retire an old entry
    on every machine (drop the "!" entry once every machine has applied it).
    null deletes the key, matching the frontmatter patcher's revert
    convention. Anything else replaces. Changes are (mark, dotted path, value)
    triples.
    """
    merged, changes = dict(current), []
    for key, want in desired.items():
        where = f"{path}.{key}" if path else key
        have = merged.get(key)
        if key not in merged and isinstance(want, (dict, list)):
            # Merge a new key into an empty container, so its null and "!"
            # entries are applied instead of written as literals.
            have = type(want)()
        if want is None:
            if key in merged:
                del merged[key]
                changes.append(("-", where, ""))
        elif isinstance(want, dict) and isinstance(have, dict):
            sub, sub_changes = merge_settings(have, want, where)
            if sub_changes:
                merged[key] = sub
                changes.extend(sub_changes)
        elif isinstance(want, list) and isinstance(have, list):
            keep, drop = split_removals(want)
            remaining = [v for v in have if v not in drop]
            removed = [v for v in have if v in drop]
            added = [v for v in keep if v not in have]
            if removed or added:
                merged[key] = remaining + added
            if removed:
                changes.append(("-", where, ", ".join(map(str, removed))))
            if added:
                changes.append(("+", where, ", ".join(map(str, added))))
        elif key not in merged:
            merged[key] = want
            changes.append(("+", where, json.dumps(want)))
        elif have != want:
            merged[key] = want
            changes.append(("~", where, json.dumps(want)))
    return merged, changes


def settings_file(root):
    return os.path.join(root, "settings.json")


def global_config_file(root):
    if os.path.realpath(root) == os.path.realpath(DEFAULT_ROOT):
        return os.path.expanduser("~/.claude.json")
    return os.path.join(root, ".claude.json")


def merge_json_overrides(section, target_for, desired, dry_run=False,
                         only_missing=False):
    print(f"\nApplying {section} overrides...")
    if not desired:
        print(f"  no {section} section, skipping")
        return

    for root in config_roots():
        target = target_for(root)
        try:
            with open(target) as f:
                current = json.load(f)
        except FileNotFoundError:
            current = {}
        except (json.JSONDecodeError, OSError) as exc:
            print(f"  {target}: unreadable, skipping ({exc})")
            continue

        # Seed: a top-level key the target already has is left alone entirely,
        # so the root owns it from the first write on.
        want = ({k: v for k, v in desired.items() if k not in current}
                if only_missing else desired)
        merged, changes = merge_settings(current, want)
        for mark, where, value in changes:
            print(f"  {mark} {where}{': ' + value if value else ''}")
        if not changes:
            print(f"  {target}: up to date")
            continue
        if dry_run:
            print(f"  {target}: {len(changes)} change(s), NOT written (--dry-run)")
            continue
        tmp = target + ".tmp"
        with open(tmp, "w") as f:
            json.dump(merged, f, indent=2, ensure_ascii=False)
            f.write("\n")
        os.replace(tmp, target)
        print(f"  {target}: {len(changes)} change(s) written")


def apply_skill_overrides(cfg, dry_run=False):
    print("\nApplying skill frontmatter overrides...")
    if not cfg:
        print("  no skills section, skipping")
        return
    if not os.path.isdir(SKILLS_DIR):
        print(f"  no skills directory at {SKILLS_DIR}, skipping")
        return

    names = sorted(
        entry
        for entry in os.listdir(SKILLS_DIR)
        if os.path.isfile(os.path.join(SKILLS_DIR, entry, "SKILL.md"))
    )
    resolved, warnings = resolve_overrides(cfg, names)

    patched = 0
    for name, values in sorted(resolved.items()):
        changes, err = patch_frontmatter(
            os.path.join(SKILLS_DIR, name, "SKILL.md"), values, dry_run=dry_run
        )
        if err:
            print(f"  {name}: {err}")
            continue
        for mark, rendered in changes:
            print(f"  {mark} {name}: {rendered}")
        patched += bool(changes)

    written = " (NOT written, --dry-run)" if dry_run and patched else ""
    print(f"  {len(resolved)} skill(s) covered, {patched} patched{written}")
    for warning in warnings:
        print(f"  warning: {warning}")


# Override sections, by target. Adding a target is a row here and nothing else:
# the section name, the handler behind it and the "not a section" warning in
# load_override_doc all come from this one mapping.
OVERRIDE_SECTIONS = {
    "skills": apply_skill_overrides,
    "settings": partial(merge_json_overrides, "settings", settings_file),
    "seed": partial(merge_json_overrides, "seed", settings_file,
                    only_missing=True),
    "config": partial(merge_json_overrides, "config", global_config_file),
}


GLOBAL_MD = os.path.join(REPO, "claude-global.md")


def link_global_md(dry_run=False):
    """Point every config root's CLAUDE.md at claude-global.md in this repo.

    A regular file is replaced only when its text is identical; otherwise it is
    reported and left alone, so a hand-written CLAUDE.md is never lost.
    """
    print("\nLinking global CLAUDE.md...")
    for root in config_roots():
        link = os.path.join(root, "CLAUDE.md")
        if os.path.islink(link) and os.readlink(link) == GLOBAL_MD:
            print(f"  {link}: up to date")
            continue
        if not os.path.isdir(root):
            print(f"  {root}: no such config root, skipping")
            continue
        if (os.path.isfile(link) and not os.path.islink(link)
                and not filecmp.cmp(link, GLOBAL_MD, shallow=False)):
            print(f"  {link}: own file that differs from {GLOBAL_MD}, "
                  "left alone; merge it by hand, then delete it")
            continue
        # "~" replaces an existing file or link (e.g. a relative chain).
        exists = os.path.lexists(link)
        mark = "~" if exists else "+"
        if not dry_run:
            if exists:
                os.remove(link)
            os.symlink(GLOBAL_MD, link)
        note = " (NOT written, --dry-run)" if dry_run else ""
        print(f"  {mark} {link} -> {GLOBAL_MD}{note}")


# -- drift ------------------------------------------------------------------
# The merge above only ADDS what the overrides name, so a key set by hand in
# one root (/config, /model, /permissions, an "always allow") survives
# silently and never reaches the other machine. The drift report lists what a
# root's settings.json holds that the overrides do not, so it can be promoted
# into claude-overrides.json (it is a PUBLIC repo: no client details) or left
# as machine-local on purpose.
#
# The report skips the dotted paths a root owns on purpose: the settings keys
# set to DRIFT_IGNORE, and the keys of the `seed` section, which each root
# owns after the first write.


def settings_drift(current, desired, ignore, path=""):
    """Yield (dotted path, value) that current holds and desired does not set."""
    for key, have in current.items():
        where = f"{path}.{key}" if path else key
        if where in ignore:
            continue
        want = desired.get(key)
        if want is None:
            yield where, have
            continue
        if isinstance(want, dict) and isinstance(have, dict):
            yield from settings_drift(have, want, ignore, where)
        elif isinstance(want, list) and isinstance(have, list):
            keep, drop = split_removals(want)
            for item in have:
                # an item a "!" entry retires is removed on apply, not drift
                if item not in keep and item not in drop:
                    yield f"{where}[]", item
        elif have != want:
            yield where, have


def report_drift(doc, ignore):
    """Print per-root drift; return the number of drifted entries."""
    print("\nDrift (in settings.json, not in claude-overrides.json):")
    desired = doc["settings"]
    ignore = ignore | set(doc.get("seed") or {})
    total = 0
    for root in config_roots():
        target = settings_file(root)
        try:
            with open(target) as f:
                current = json.load(f)
        except FileNotFoundError:
            continue
        except (json.JSONDecodeError, OSError) as exc:
            print(f"  {target}: unreadable ({exc})")
            continue
        drift = list(settings_drift(current, desired, ignore))
        total += len(drift)
        print(f"  {target}: {len(drift) or 'none'}")
        for where, value in drift:
            print(f"    {where}: {json.dumps(value, ensure_ascii=False)[:120]}")
    if total:
        print("  Promote shared entries into claude-overrides.json, or leave "
              f"machine-local ones; set a deliberate local key to \"{DRIFT_IGNORE}\" there.")
    return total


def apply_overrides(dry_run=False):
    """Link each root's CLAUDE.md, hand each claude-overrides.json section to
    its target, then report drift."""
    link_global_md(dry_run)
    doc, ignore = load_override_doc()
    if doc is None:
        return
    for section, handler in OVERRIDE_SECTIONS.items():
        handler(doc.get(section) or {}, dry_run=dry_run)
    report_drift(doc, ignore)


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--overrides-only", action="store_true",
                    help=f"re-apply overrides only ({', '.join(OVERRIDE_SECTIONS)}), "
                         "skipping every marketplace, plugin and skill update")
    ap.add_argument("--dry-run", action="store_true",
                    help="preview override changes without writing them")
    ap.add_argument("--drift", action="store_true",
                    help="only report settings.json keys the overrides do not "
                         "manage; exit 1 when there are any")
    args = ap.parse_args()

    if args.drift:
        doc, ignore = load_override_doc()
        return 1 if doc is None or report_drift(doc, ignore) else 0

    if args.overrides_only:
        apply_overrides(args.dry_run)
        return 0

    print("=" * 64)
    print("UPDATING CLAUDE CODE")
    print("=" * 64)

    if not shutil.which("claude"):
        print("Claude Code CLI not found, skipping plugin updates")
    else:
        update_cli()
        update_roots(config_roots())

    print("\nUpdating skills...")
    install_missing_skills()
    try:
        rc = subprocess.run(
            ["npx", "--yes", "skills", "update", "-g"],
            stdin=subprocess.DEVNULL,
            timeout=600,
        ).returncode
        print("  skills updated" if rc == 0 else f"  skills update failed: rc={rc}")
    except subprocess.TimeoutExpired:
        print("  skills update timed out after 600s")

    apply_overrides(args.dry_run)

    print("\n>>> Restart Claude Code to apply plugin updates "
          "(versions are pinned at process start).")


if __name__ == "__main__":
    sys.exit(main())
