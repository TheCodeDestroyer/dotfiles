# Profiles                                                                     #
# --------------------------------------------------------------------------- #

class Profile(NamedTuple):
    """Everything that makes a profile a profile, in one place.

    `mode` is what bd writes to .beads/metadata.json as dolt_mode; it is the
    only handle on which profile a repo already belongs to, so name, mode and
    entry point have to travel together. A row in PROFILES is the whole
    registration: the flag, its --help line and the "pick a profile" guidance
    all render from here.
    """
    name: str
    mode: str
    summary: str
    entry: Callable[..., int]

    @property
    def flag(self) -> str:
        return f"--{self.name}"


PERSONAL = Profile("personal", "server",
                   "central Dolt server from central.conf (mini)", central_main)
WORK = Profile("work", "embedded",
               "embedded Dolt, synced over the repo's git remote", embedded_main)
PROFILES = (PERSONAL, WORK)
BY_MODE = {p.mode: p for p in PROFILES}


def profile_conflict(meta: dict, want: Profile) -> str | None:
    """Why this repo must not be re-initialized as `want`, or None.

    `.beads/metadata.json` records the storage mode bd initialized with. A
    *different* mode means the repo belongs to the other profile, and silently
    re-initializing it would move its issues to another home — refuse instead.
    """
    have = meta.get("dolt_mode")
    if not have or have == want.mode:
        return None
    # `have` comes from bd, not from BY_MODE, so a future bd mode is possible.
    known = BY_MODE.get(have)
    return (f"this repo is already initialized in {have} mode "
            f"({known.flag if known else 'unknown profile'}), not {want.mode} "
            "mode. Refusing to re-init across profiles — remove .beads/ first "
            "if that is really what you want.")


GIDEON_REGISTRY_REFRESH = (Path.home()
                           / "Work/gideon/bin/morning-coffee/refresh-beads-registry.py")


def refresh_fleet_registry(db: str) -> None:
    """Tell gideon's morning-coffee about the newly initialized repo (gideon-shu4).

    morning-coffee reads issues for every project listed in gideon's
    beads-projects.json, and nothing can enumerate the fleet remotely: central
    repos are databases on the mini, work repos are refs/dolt/data on their own
    git remotes. The generator derives both from THIS machine (central.conf +
    a ~/Work scan), so a freshly initialized repo only shows up in the brief
    once it has run. --commit pushes the registry to gideon when it changed.

    Best-effort by design: this is a courtesy to a different repo. A missing
    gideon checkout, an unreachable mini or a failed push must never turn a
    successful init into a failure.
    """
    if not GIDEON_REGISTRY_REFRESH.is_file():
        return
    print("bdi: refreshing gideon's fleet registry")
    try:
        # The child self-caps its own dolt probe at 30s; the rest of the budget
        # is the git push. GIT_TERMINAL_PROMPT keeps a credential prompt from
        # holding the terminal until the timeout fires.
        rc = subprocess.run([str(GIDEON_REGISTRY_REFRESH), "--commit"],
                            env={**env_without(*ROUTING_PREFIXES),
                                 "GIT_TERMINAL_PROMPT": "0"},
                            timeout=60).returncode
        if rc == 0:
            return
        why = f"rc={rc}"
    except (OSError, subprocess.TimeoutExpired) as e:
        why = str(e)
    warn(f"gideon registry not refreshed ({why}) — run "
         f"{GIDEON_REGISTRY_REFRESH} --commit by hand so morning-coffee sees {db}")


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=(__doc__ or "").strip().splitlines()[0])
    # One mutually exclusive group for every mode, --repoint included, so
    # argparse rejects the invalid combinations instead of main() re-deriving
    # them. Not `required=True`: the generated message would replace the
    # guidance below, which names what each profile actually does.
    mode = ap.add_mutually_exclusive_group()
    # const is the Profile record itself, so the flag, the dolt_mode it implies
    # and the entry point behind it can never drift apart.
    for profile in PROFILES:
        mode.add_argument(profile.flag, dest="profile", action="store_const",
                          const=profile,
                          help=f"{profile.name.capitalize()} profile: {profile.summary}")
    mode.add_argument("--repoint", action="store_true",
                      help="Rewrite this repo's .beads/ env file from central.conf and exit"
                           " (--personal repos only)")
    ap.add_argument("--dry-run", action="store_true",
                    help="Print what would happen without making any changes")
    args, passthrough = ap.parse_known_args(argv)

    root = git_root()
    if root is None:
        return fail("not in a git repo")
    root_path = Path(root)
    db = db_name(root)
    if not re.fullmatch(r"[A-Za-z0-9_]+", db):
        return fail(f"refusing db name {db!r} derived from the repo directory — "
                    "expected only letters, digits, and underscores. Rename the "
                    "directory.")

    meta = read_metadata(root_path)

    if args.repoint:
        # Only the central profile has a connection to repoint; any other
        # dolt_mode belongs to some other profile, present or future.
        repo_mode = meta.get("dolt_mode")
        if repo_mode and repo_mode != PERSONAL.mode:
            return fail("--repoint is for --personal repos only; a work repo "
                        "has no central connection to repoint")
        cfg = load_central_config()
        p = write_env_file(root_path, cfg)
        print(f"bdi: repointed {p} → {cfg['HOST']}:{cfg['PORT']}")
        return 0

    # No default profile on purpose: guessing wrong sends a repo's issues to the
    # wrong home, and that is only discovered later.
    if not args.profile:
        return fail("pick a profile — "
                    + "; ".join(f"{p.flag}: {p.summary}" for p in PROFILES), code=2)

    if err := profile_conflict(meta, args.profile):
        return fail(err)

    resuming = meta.get("dolt_database") == db
    rc = args.profile.entry(root_path, db, passthrough, dry_run=args.dry_run,
                            resuming=resuming)
    # Only a first init can add a project the registry has never seen; on resume
    # the generator would re-derive an identical fleet at the cost of a network
    # round trip. Anything that goes stale another way is caught by gideon's own
    # pre-push freshness guard.
    if rc == 0 and not args.dry_run and not resuming:
        refresh_fleet_registry(db)
    return rc


if __name__ == "__main__":
    sys.exit(main())
