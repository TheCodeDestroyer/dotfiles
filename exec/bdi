#!/usr/bin/env python3

"""
bdi - Streamlined `bd init`, in two profiles. One of them is always required.

--personal (central mode): wire the repo to the personal Dolt server (the mini
over Tailscale). Issues live off-machine, never on the repo's git remote:
  1. CREATE DATABASE <db> on the central server (host-side dolt; idempotent)
  2. bd init --server --external --server-host H --server-port P --database <db>
     --skip-agents --skip-hooks   (lays the beads schema into that database)
  3. write .beads/ env file so every bd call in this repo routes to the central
     server (bd otherwise silently defaults to the machine-wide shared server)
  4. correct config.yaml (no auto-push, no export git-add, and above all no
     sync.remote — bd init aims that at the repo's own git remote regardless
     of profile), bd dolt commit (commit the initial schema), + .gitignore
     hygiene (which also untracks the .beads/ runtime files `bd init` may
     have committed)

The central connection is read from ~/.config/beads/central.conf
(BEADS_DOLT_SERVER_HOST/PORT/USER + BEADS_DOLT_PASSWORD/TLS; env vars override).
That file is the single knob: change it when the server moves hosts, then run
`bdi --repoint` inside each central-server repo to refresh its env file.

--work (embedded mode): for work repos, which must not depend on the mini or on
any other personal infrastructure. The database is per-repo and embedded in
.beads/embeddeddolt/, and issues travel over the repo's OWN git remote
(sync.remote -> refs/dolt/data), so a clone carries them:
  1. bd init --skip-agents under BD_DOLT_SHARED_SERVER=false (bd installs its
     git hooks, derives sync.remote from origin, git-adds and COMMITS .beads/,
     and pushes the database to refs/dolt/data straight away — init publishes,
     there is no dry local phase)
  2. persist dolt.shared-server: false in .beads/config.yaml — the user-global
     ~/.config/bd/config.yaml turns the shared server ON machine-wide, so
     without this every later bd call disagrees with metadata.json
  3. bd dolt commit — pushes the schema to the git remote when it is reachable

There is no default profile. A repo initialized into the wrong one quietly sends
work issues to a personal server, or personal issues to a work remote, so `bdi`
with neither flag is an error, and re-initializing across profiles is refused.

--repoint: rewrite this repo's .beads/ env file from central.conf and exit
(--personal repos only).

Extra args are forwarded to `bd init`. Use --dry-run to preview without changes.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path
from typing import Callable, NamedTuple

CENTRAL_CONF = Path.home() / ".config" / "beads" / "central.conf"
GLOBAL_DB = "beads_global"  # bd references a global db; ensure it exists server-side

# Every env prefix bdi injects to route bd at a database. Stripped whenever a
# child must resolve config the way a bare `bd` would, or must not be routed
# at all.
ROUTING_PREFIXES = ("BEADS_DOLT_", "BD_DOLT_")


def capture(cmd: list[str], **kw) -> str | None:
    """Stripped stdout of `cmd`, or None if it failed, timed out, or was empty.

    Every probe in bdi wants the same thing — an answer, or nothing it has to
    handle — so a missing binary and a hung network call are both just None.
    """
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, **kw)
    except (FileNotFoundError, NotADirectoryError, subprocess.TimeoutExpired):
        return None
    out = r.stdout.strip()
    return out if r.returncode == 0 and out else None


def git_root(cwd: str | Path | None = None) -> str | None:
    return capture(["git", "rev-parse", "--show-toplevel"], cwd=cwd)


def db_name(root: str) -> str:
    # Mirror bd's prefix-based DB naming: basename with '-' and '.' -> '_'.
    return Path(root).name.replace("-", "_").replace(".", "_")


def run(cmd: list[str], env: dict | None = None) -> int:
    r = subprocess.run(cmd, env=env)
    if r.returncode != 0:
        return fail(f"`{' '.join(cmd)}` failed", r.returncode)
    return 0


def warn(msg: str) -> None:
    """Note something the user should know without aborting the run."""
    print(f"bdi: {msg}", file=sys.stderr)


def fail(msg: str, code: int = 1) -> int:
    """Report a refusal on stderr and hand back the exit code to return."""
    warn(msg)
    return code


def git_out(root: Path, *args: str, timeout: float | None = None) -> str | None:
    """Stripped stdout of `git -C <root> <args>`, or None if it failed."""
    return capture(["git", "-C", str(root), *args], timeout=timeout)


def env_without(*prefixes: str) -> dict:
    """A copy of the process env with every variable matching a prefix removed."""
    return {k: v for k, v in os.environ.items() if not k.startswith(prefixes)}


def read_metadata(root: Path) -> dict:
    """bd's .beads/metadata.json, or {} when absent/unreadable.

    Treat any parse/read failure as "not initialized" so callers fall through
    to bd init rather than guessing at a half-written state.
    """
    try:
        return json.loads((root / ".beads" / "metadata.json").read_text())
    except (json.JSONDecodeError, OSError):
        return {}


def bd_init_or_resume(db: str, argv: list[str], env: dict, resuming: bool) -> int:
    """Run `bd init` with a profile's arguments, or announce the resume skip.

    `resuming` means metadata.json already names this database, so bd init is a
    no-op at best and an error at worst.
    """
    if resuming:
        print(f"bdi: resuming — bd init already complete for {db}")
        return 0
    return run(["bd", "init", *argv], env=env)


def print_plan(rows: list[tuple[str, str]]) -> None:
    """Render a --dry-run plan so both profiles share one label column."""
    print("bdi: dry-run — no changes will be made")
    width = max(len(label) for label, _ in rows)
    for label, value in rows:
        print(f"  {label.ljust(width)} : {value}")


def init_plan_line(resuming: bool, db: str, argv: list[str], env_note: str = "") -> str:
    """The `bd init` row of a --dry-run plan, for either profile."""
    if resuming:
        return f"skipped (resume: metadata.json already records dolt_database={db})"
    return shlex.join(argv) + env_note


# The .beads/ files git should carry, everything else in there being database,
# runtime or connection state. config.yaml is the repo's beads settings;
# metadata.json is its identity — issue prefix, project_id, database name. A
# clone without metadata.json cannot repoint, and re-running `bd init` to
# rebuild it risks minting a fresh project_id against the very database the old
# one named.
TRACKED_BEADS_FILES = ("config.yaml", "metadata.json")
TRACKED_BEADS_LIST = ", ".join(TRACKED_BEADS_FILES)  # for user-facing messages


def ignored_paths(root: Path, paths: list[str]) -> list[str]:
    """Which of `paths` .gitignore would ignore were they not already tracked.

    --no-index is the whole point: check-ignore consults the index by default
    and reports nothing for a tracked path, which is precisely the case being
    diagnosed here. Asking git rather than re-matching the patterns in python
    honors negations bdi did not write.

    check-ignore is variadic and echoes back exactly the ignored pathnames, so
    the whole set costs one invocation. Nothing ignored — and no paths at all —
    both exit non-zero, which capture already reads as "no answer".
    """
    out = git_out(root, "check-ignore", "--no-index", "--", *paths)
    return out.splitlines() if out else []


def untrack_ignored_beads(root: Path) -> None:
    """Drop .beads/ files git tracks but .gitignore now ignores.

    Writing the pattern is not enough. .gitignore has no effect on paths
    already in the index, and `bd init` stages and commits the whole .beads/
    directory before bdi ever gets to run — so the pattern lands too late to
    mean anything. Left tracked, .beads/interactions.jsonl (an append-only,
    per-machine interaction log) re-diffs on every bd write, forever.

    Central profile only: work repos are meant to commit .beads/, so bd's
    config and hooks travel with the clone (see embedded_main's closing note).

    Staged, not committed: bdi does not make commits in this profile, and which
    commit these deletions belong in is the user's call.

    --force because plain `git rm --cached` refuses any file whose staged
    content differs from both the worktree and HEAD — and then drops the whole
    batch, not just that path. These files are exactly the ones being written
    behind git's back, so that refusal is the normal case, not the exception.
    It only rewrites the index: --cached never touches the file on disk.
    """
    tracked = (git_out(root, "ls-files", "--", ".beads") or "").splitlines()
    stale = ignored_paths(root, tracked)
    if not stale:
        return
    if run(["git", "-C", str(root), "rm", "--cached", "--force", "--quiet",
            "--", *stale]) == 0:
        print(f"bdi: untracked {', '.join(stale)} — staged, commit to apply")


def ensure_gitignore(root: Path) -> None:
    """Idempotently ignore .beads/ runtime, keeping the tracked files tracked."""
    gi = root / ".gitignore"
    lines = gi.read_text().splitlines() if gi.exists() else []
    has_ignore = ".beads/*" in lines
    missing = [f"!.beads/{name}" for name in TRACKED_BEADS_FILES
               if f"!.beads/{name}" not in lines]
    if has_ignore and not missing:
        return

    additions: list[str] = []
    if not has_ignore:
        additions += [
            "",
            f"# Beads: track only {TRACKED_BEADS_LIST}; "
            "ignore db/runtime/connection env",
            ".beads/*",
        ]
    additions += missing

    # Drop the leading separator blank when the file is empty or already ends
    # in a blank line.
    if additions and additions[0] == "" and (not lines or lines[-1] == ""):
        additions = additions[1:]

    text = "\n".join(lines + additions).rstrip("\n") + "\n"
    gi.write_text(text)
    print(f"bdi: updated {gi} (track {TRACKED_BEADS_LIST})")


# --------------------------------------------------------------------------- #
# Personal profile — central server (mini)                                     #
# --------------------------------------------------------------------------- #

def _env_truthy(v: str) -> bool:
    """Interpret a BEADS_DOLT_SERVER_TLS-style string as a bool."""
    return v not in ("", "0", "false", "False")


def load_central_config() -> dict:
    """Resolve central server connection: defaults <- central.conf <- env."""
    cfg = {"HOST": "127.0.0.1", "PORT": "3310", "USER": "root",
           "PASSWORD": "", "TLS": False}
    path = Path(os.environ.get("BDI_CENTRAL_CONFIG", CENTRAL_CONF))
    key_map = {
        "BEADS_DOLT_SERVER_HOST": "HOST",
        "BEADS_DOLT_SERVER_PORT": "PORT",
        "BEADS_DOLT_SERVER_USER": "USER",
        "BEADS_DOLT_PASSWORD": "PASSWORD",
    }
    if path.exists():
        for line in path.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = (s.strip() for s in line.split("=", 1))
            if k in key_map:
                cfg[key_map[k]] = v
            elif k == "BEADS_DOLT_SERVER_TLS":
                cfg["TLS"] = _env_truthy(v)
    else:
        warn(f"{path} not found — using defaults ({cfg['HOST']}:{cfg['PORT']})")
    # Process-env overrides win (handy for one-off targeting).
    for env_key, cfg_key in key_map.items():
        if env_key in os.environ:
            cfg[cfg_key] = os.environ[env_key]
    if "BEADS_DOLT_SERVER_TLS" in os.environ:
        cfg["TLS"] = _env_truthy(os.environ["BEADS_DOLT_SERVER_TLS"])
    return cfg


def central_pairs(cfg: dict) -> list[tuple[str, str]]:
    """The central connection rendered as ordered env key/value pairs.

    Single source of truth for both the subprocess env (central_env) and the
    per-repo .beads/.env file (write_env_file) — add a routing key here once.
    """
    pairs = [
        ("BEADS_DOLT_SERVER_HOST", cfg["HOST"]),
        ("BEADS_DOLT_SERVER_PORT", str(cfg["PORT"])),
        ("BEADS_DOLT_SERVER_USER", cfg["USER"]),
        ("BEADS_DOLT_PASSWORD", cfg["PASSWORD"]),
        ("BEADS_DOLT_AUTO_START", "0"),
    ]
    if cfg["TLS"]:
        pairs.append(("BEADS_DOLT_SERVER_TLS", "1"))
    return pairs


def central_env(cfg: dict) -> dict:
    """Process env that routes bd to the central server."""
    return {**os.environ, **dict(central_pairs(cfg))}


def dolt_server_sql(cfg: dict, query: str) -> tuple[int, str, str]:
    """Run a SQL statement against the central server with the host-side dolt CLI.

    Uses dolt's global --host/--port flags, so it works identically whether the
    server is the local container or a remote box (mini over Tailscale).
    """
    cmd = ["dolt", "--host", cfg["HOST"], "--port", str(cfg["PORT"]),
           "--user", cfg["USER"], "--password", cfg["PASSWORD"]]
    if not cfg["TLS"]:
        cmd.append("--no-tls")
    cmd += ["sql", "-q", query]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
    except FileNotFoundError:
        return 127, "", "dolt CLI not found on PATH"
    except subprocess.TimeoutExpired:
        # A black-holed Tailscale route never RSTs, and capture_output means a
        # hang looks like a dead terminal rather than a slow one.
        return 124, "", f"timed out connecting to {cfg['HOST']}:{cfg['PORT']}"
    return r.returncode, r.stdout, r.stderr


def write_env_file(root: Path, cfg: dict) -> Path:
    """Write the per-repo .beads/ connection env file (bd auto-loads it)."""
    env_path = root / ".beads" / (".e" + "nv")  # bd auto-loads .beads/.env
    env_path.parent.mkdir(parents=True, exist_ok=True)
    body = "\n".join([
        "# Routes this repo to the central beads Dolt server (managed by bdi).",
        "# Source of truth: ~/.config/beads/central.conf  (refresh: bdi --repoint)",
        *(f"{k}={v}" for k, v in central_pairs(cfg)),
    ])
    env_path.write_text(body + "\n")
    os.chmod(env_path, 0o600)
    return env_path


# What a central repo's config.yaml has to say, whatever `bd init` left there
# (None = the key must be absent; see apply_config_keys).
#
# dolt.auto-push: there is no git remote to push issues to, and every write
#   would otherwise spend a failing attempt on one.
# export.git-add: bd would stage an auto-exported .beads/issues.jsonl into the
#   repo, which is the one thing .gitignore is set up here to prevent.
# sync.remote: `bd init` derives it from origin whatever the profile, aiming a
#   personal repo's issue database at the repo's own — often public — git
#   remote. Nothing about these issues belongs there; they live on the central
#   server. Deleted after the fact because there is no lever earlier: bd init
#   has no flag to suppress it (`--remote` only sets one), and `bd config
#   unset` is a bd write, so it would attempt the very push being disabled.
CENTRAL_CONFIG = {
    "dolt.auto-push": "false",
    "export.git-add": "false",
    "sync.remote": None,
}


def central_main(root_path: Path, db: str, passthrough: list[str], dry_run: bool,
                 resuming: bool) -> int:
    cfg = load_central_config()
    server = f"{cfg['HOST']}:{cfg['PORT']}"

    init_argv = [
        "--server", "--external",
        "--server-host", cfg["HOST"], "--server-port", str(cfg["PORT"]),
        "--database", db, "--skip-agents", "--skip-hooks", *passthrough,
    ]

    if dry_run:
        print_plan([
            ("central", f"{server} (tls={cfg['TLS']})"),
            ("create db", f"CREATE DATABASE IF NOT EXISTS {db}  (+ {GLOBAL_DB})"),
            ("bd init", init_plan_line(resuming, db, init_argv)),
            ("env file", ".beads/ -> BEADS_DOLT_SERVER_HOST/PORT/USER/PASSWORD"),
            ("config.yaml", ", ".join(f"{k}: {v}" if v is not None
                                      else f"drop {k}"
                                      for k, v in CENTRAL_CONFIG.items())),
            ("then", "bd dolt commit"),
            (".gitignore", f"ensure '.beads/*' + keep {TRACKED_BEADS_LIST}"),
            ("untrack", "git rm --cached the ignored .beads/ files bd init "
                        "committed (staged, not committed)"),
        ])
        return 0

    # 1. Ensure the global db and the project db exist on the server (live, no
    #    restart), in one dolt invocation. db is validated [A-Za-z0-9_]+ in
    #    main() and GLOBAL_DB is constant, so both are safe to interpolate.
    rc, _out, err = dolt_server_sql(
        cfg,
        f"CREATE DATABASE IF NOT EXISTS {GLOBAL_DB}; "
        f"CREATE DATABASE IF NOT EXISTS {db};",
    )
    if rc != 0:
        return fail(f"could not create databases on {server}: {err.strip()}")

    env = central_env(cfg)

    # 2. Initialize beads schema in the external database (skip when resuming).
    rc = bd_init_or_resume(db, init_argv, env, resuming)
    if rc != 0:
        return rc

    # 3. Write the per-repo connection env file (the actual routing).
    env_path = write_env_file(root_path, cfg)
    print(f"bdi: wrote {env_path}")

    # 4. Correct what `bd init` wrote into config.yaml (see the constants
    #    above). Plain file edits: `bd config set` would itself trigger the very
    #    push attempt being disabled here. Governs all future writes in this repo.
    apply_config_keys(root_path / ".beads" / "config.yaml", CENTRAL_CONFIG)

    # 5. Commit the initial schema so the working set is clean. --sandbox skips
    #    the auto-push attempt (central repos have no origin to push to).
    run(["bd", "dolt", "commit", "--sandbox"], env=env)

    # 6. Keep config.yaml and metadata.json tracked; ignore db/runtime/env.
    ensure_gitignore(root_path)

    # 7. bd init committed .beads/ before that rule existed; stage the removals.
    untrack_ignored_beads(root_path)

    print(f"bdi: {db} ready on central server {server}")
    return 0


# --------------------------------------------------------------------------- #
# Work profile — embedded Dolt, synced over the repo's own git remote          #
# --------------------------------------------------------------------------- #

# The env bd needs on top of a stripped one for an embedded init (see
# embedded_env). Named so --dry-run can report it rather than restate it.
EMBEDDED_OVERRIDES = {"BD_DOLT_SHARED_SERVER": "false"}


def embedded_env() -> dict:
    """Process env for an embedded init: no central server, no shared server.

    Two things have to be neutralized. BEADS_DOLT_* would route bd at the
    personal server (they leak in from a parent shell or a sourced .env), and
    the machine-wide ~/.config/bd/config.yaml sets dolt.shared-server: true,
    which puts the database in ~/.beads/shared-server instead of the repo.
    `bd init --shared-server=false` does NOT override that config value; the
    BD_ env var does, so that is what we use.
    """
    return {**env_without("BEADS_DOLT_"), **EMBEDDED_OVERRIDES}


def sync_remote_url(origin: str) -> str | None:
    """Render a git remote URL in bd's `git+<scheme>://` sync.remote form."""
    m = re.fullmatch(r"(?:ssh://)?(\w[\w.-]*)@([^:/]+)[:/](.+?)(?:\.git)?/?", origin)
    if m:
        user, host, path = m.groups()
        return f"git+ssh://{user}@{host}/{path}.git"
    m = re.fullmatch(r"(https?)://(.+?)(?:\.git)?/?", origin)
    if m:
        return f"git+{m.group(1)}://{m.group(2)}.git"
    return None


def remote_has_beads_data(root: Path) -> bool:
    """Whether origin already carries a beads database (refs/dolt/data).

    bd init does not just create a local database: it pushes to sync.remote
    immediately, and when the remote already holds beads data it ADOPTS it —
    issue prefix and project id then come from whatever pushed there first, not
    from this directory. Worth saying out loud before it happens.

    Advisory only, so the timeout is short and an unreachable origin just means
    "no warning" — this must never be what fails the run it is decorating.
    """
    return bool(git_out(root, "ls-remote", "origin", "refs/dolt/data", timeout=10))


def hook_owner(root: Path) -> tuple[str | None, list[str]]:
    """Who owns this repo's git hooks — asked BEFORE `bd init` runs.

    bd init points core.hooksPath at .beads/hooks, taking the whole hook path
    over; in a repo running lefthook or husky that silently disables every
    existing hook (lint, format, commit-msg). Asking first is what makes the
    answer usable: afterwards core.hooksPath is bd's, and a hooks scan would
    just find bd's own directory.

    Returns (prior core.hooksPath, names of the hook managers found).
    """
    prior = git_out(root, "config", "--get", "core.hooksPath")
    found = []
    if any((root / n).exists() for n in ("lefthook.yml", "lefthook.yaml")):
        found.append("lefthook")
    if (root / ".husky").is_dir():
        found.append("husky")
    out = git_out(root, "rev-parse", "--git-path", "hooks")
    if out:
        hooks = Path(out)
        hooks = hooks if hooks.is_absolute() else root / hooks
        if hooks.is_dir() and any(not p.name.endswith(".sample") for p in hooks.iterdir()):
            found.append("installed hooks")
    return prior, found


def restore_hooks_path(root: Path, prior: str | None, managers: list[str]) -> None:
    """Give the hook path back after bd init took it over.

    "Changed from what we saw before init" is the whole test — no assumption
    about where bd points it. Restoring `prior` rather than unsetting matters
    for husky, which owns core.hooksPath itself. Losing bd's hooks costs
    automatic hydration on merge/checkout, not sync: writes still push via
    dolt.auto-push, and `bd dolt pull` re-hydrates after a git pull.
    """
    current = git_out(root, "config", "--get", "core.hooksPath")
    if current == prior or not (prior or managers):
        return
    if prior:
        run(["git", "-C", str(root), "config", "core.hooksPath", prior])
        action = f"restored core.hooksPath to {prior}"
    else:
        run(["git", "-C", str(root), "config", "--unset", "core.hooksPath"])
        action = "unset core.hooksPath"
    print(f"bdi: {action} — this repo runs its own hooks "
          f"({', '.join(managers) or 'own core.hooksPath'}) and bd init had "
          f"pointed the hook path at {current}, disabling them. Beads still "
          "syncs on write via dolt.auto-push; run `bd dolt pull` after a git "
          "pull to hydrate.")


def effective_config(root: Path, key: str) -> str | None:
    """What a plain `bd` call in this repo resolves `key` to, or None if unset.

    `bd config get` exits 0 either way and prints `<key> (not set...)` when
    there is no value, so the sentinel has to be recognized — the exit code
    says nothing.
    """
    # Strip every bdi-injected routing override, so this reports what a bare
    # `bd` call resolves — i.e. that the settings landed on disk, not just in
    # our subprocess env.
    out = capture(["bd", "-C", str(root), "config", "get", key],
                  env=env_without(*ROUTING_PREFIXES))
    return None if out is None or out.startswith(f"{key} (not set") else out


def embedded_main(root_path: Path, db: str, passthrough: list[str], dry_run: bool,
                  resuming: bool) -> int:
    origin = git_out(root_path, "remote", "get-url", "origin")
    remote = sync_remote_url(origin) if origin else None
    if origin and not remote:
        warn(f"could not parse origin {origin!r} into a sync.remote URL — "
             "issues will stay local until you set sync.remote by hand")

    # Snapshot hook ownership before bd init can overwrite the evidence.
    prior_hooks, managers = hook_owner(root_path)

    init_argv = ["--skip-agents", *passthrough]

    if dry_run:
        env_note = "  [" + " ".join(f"{k}={v}" for k, v in EMBEDDED_OVERRIDES.items()) + "]"
        hooks_line = (f"keep {', '.join(managers)} (restore bd's core.hooksPath)"
                      if managers or prior_hooks else "bd hooks via core.hooksPath")
        print_plan([
            ("profile", "work (embedded Dolt in .beads/embeddeddolt/)"),
            ("database", db),
            ("bd init", init_plan_line(resuming, db, init_argv, env_note)),
            ("sync.remote", remote or "none (no git origin) — issues stay local"),
            ("config.yaml", "dolt.shared-server: false"),
            ("hooks", hooks_line),
            ("then", "bd dolt commit"),
        ])
        return 0

    env = embedded_env()

    # 1. Embedded init. Hooks and AGENTS.md: bd's git hooks are what carry the
    #    issue data on push/merge, so they stay; agent files do not (work repos
    #    already have their own CLAUDE.md / AGENTS.md).
    if not resuming and origin and remote_has_beads_data(root_path):
        print("bdi: origin already carries beads data (refs/dolt/data) — bd "
              "init will adopt it, so the issue prefix and project id come "
              "from there, not from this directory. Delete that ref first if "
              "you meant to start clean.")
    rc = bd_init_or_resume(db, init_argv, env, resuming)
    if rc != 0:
        return rc

    # 2. Persist the shared-server opt-out (see embedded_env) and, as a
    #    fallback, sync.remote — bd init derives it from origin itself, so only
    #    write it when bd did not. Ask bd what resolves rather than scanning the
    #    file for the key: some bd versions ship a commented `# sync.remote:`
    #    placeholder, which a substring test reads as a value that is set.
    cfg_path = root_path / ".beads" / "config.yaml"
    keys = {"dolt.shared-server": "false"}
    if remote and not effective_config(root_path, "sync.remote"):
        keys["sync.remote"] = f'"{remote}"'
    apply_config_keys(cfg_path, keys)

    # 3. Verify the opt-out actually resolves. Not a check on the write —
    #    apply_config_keys already cuts any competing nested `dolt:` block —
    #    but on everything layered over it that bdi cannot see from the file:
    #    the machine-wide ~/.config/bd/config.yaml, BD_ env vars, bd version
    #    drift. effective_config asks bd, which is the only authority.
    if effective_config(root_path, "dolt.shared-server") != "false":
        return fail(f"{cfg_path} still resolves dolt.shared-server to true — "
                    "fix it by hand before using this repo (the database would "
                    "land in ~/.beads/shared-server, not in the repo)")

    # 4. Keep the repo's own hooks working (bd init hijacks core.hooksPath).
    restore_hooks_path(root_path, prior_hooks, managers)

    # 5. Commit the initial schema. No --sandbox here: unlike central repos, the
    #    push IS the sync — it writes refs/dolt/data on the repo's git remote.
    run(["bd", "dolt", "commit"], env=env)

    print(f"bdi: {db} ready (embedded)"
          + (f", syncing over {remote}" if remote else ", local-only (no origin)"))
    print("bdi: commit .beads/ so the config and hooks travel with the repo")
    return 0


# --------------------------------------------------------------------------- #
# Config file helpers                                                          #
# --------------------------------------------------------------------------- #

def apply_config_keys(cfg: Path, keys: dict[str, str | None]) -> None:
    """Ensure config.yaml has exactly one active `key: value` line per key.

    Replaces any active or commented occurrence in place; appends the rest. A
    None value means the key has to be ABSENT — absent, not YAML null — for
    settings where any value at all would be wrong. That is the same sentinel
    `patch_frontmatter` uses in exec/claude-update, for the same reason.
    Done in a single read/write so the keys land atomically — a fresh `bd init`
    ships a commented `# sync.remote:` placeholder, so `bd config set` can't be
    relied on (it edits that placeholder in place but leaves it commented).

    A nested block counts as an occurrence. `bd init` writes some settings as a
    mapping (`dolt:` / `    shared-server: true`), and with both spellings in
    the file bd resolves them inconsistently: it reads shared-server out of the
    block but auto-push off the flat line. Writing the flat key is therefore no
    fix while the block survives, so managed keys are cut out of the block —
    taking the header with them once nothing is left underneath it. A header
    whose children were all kept, or that had none to begin with, stays.

    Only active lines open or extend a block: bd's shipped config comments out
    whole example mappings (`# export:` / `#   git-add: false`), and those are
    documentation, not settings.

    The dialect this reads, and no more: top-level keys, one level of nesting,
    scalar values, and `foo:` alone on a line as a block header. That covers
    everything bd writes; anything richer belongs in a real YAML parser, which
    would cost this file its comments (see the module header).
    """
    out: list[str] = []
    seen: set[str] = set()
    block: str | None = None   # top-level mapping currently being scanned
    header: int | None = None  # index of its header line in `out`
    kept = removed = False     # what became of the lines under it

    def managed(text: str) -> str | None:
        """Which key `text` spells, nested and flat alike — the trailing colon
        is what keeps the prefix test from reading dolt.auto-push-extra as
        dolt.auto-push."""
        return next((k for k in keys if text.startswith(k + ":")), None)

    def close_block() -> None:
        nonlocal block, header, kept, removed
        if header is not None and removed and not kept:
            del out[header]
        block, header, kept, removed = None, None, False, False

    for line in cfg.read_text().splitlines():
        stripped = line.strip()
        active = bool(stripped) and not stripped.startswith("#")

        if active and line[:1].isspace():          # a line inside a mapping
            if block is not None:
                if managed(f"{block}.{stripped}") is not None:
                    removed = True
                    continue  # respelled flat below, or dropped outright
                kept = True
            out.append(line)
            continue

        if active:
            close_block()

        matched = managed(stripped if active else stripped.lstrip("#").strip())
        if matched is not None:
            want = keys[matched]
            if want is None:
                # Delete the setting. A commented one is left alone: bd ships
                # those as documentation, and blanking a placeholder that is
                # already inert says nothing.
                if active:
                    continue
            else:
                if matched not in seen:
                    out.append(f"{matched}: {want}")
                    seen.add(matched)
                continue  # drop duplicates / the commented variant

        if active and stripped.endswith(":"):
            block, header = stripped[:-1], len(out)
        out.append(line)
    close_block()

    missing = [(k, v) for k, v in keys.items()
               if v is not None and k not in seen]
    if missing:
        if out and out[-1].strip() != "":
            out.append("")
        out += [f"{k}: {v}" for k, v in missing]
    cfg.write_text("\n".join(out).rstrip("\n") + "\n")


