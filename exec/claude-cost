#!/usr/bin/env python3
"""claude-cost — Aggregate Claude Code token usage & estimated cost across all sessions.

Usage:
  claude-cost              # current month
  claude-cost 2026-03      # specific month
  claude-cost --all        # all time
  claude-cost --daily      # daily breakdown for current month
  claude-cost --daily 2026-03  # daily breakdown for specific month
  claude-cost --monthly    # per-month breakdown across all time

Data is cached in ~/.claude/usage-ledger.json so historical data survives
session cleanup (default 30 days). Live sessions are only scanned when
the requested period includes recent/current data.
"""

import json
import os
import re
import sys
import urllib.request
from collections import defaultdict
from datetime import datetime, timedelta
from pathlib import Path

# ── Pricing (per million tokens, USD) ──
# Direct Anthropic API rates. Cross-checked against the LiteLLM price table
# (github.com/BerriAI/litellm) and models.dev. NOTE: the Opus line dropped from
# $15/$75 to $5/$25 starting with Opus 4.5 — older hardcoded values here were
# the Opus 4/4.1-era rates and overstated cost ~3x.
# https://docs.anthropic.com/en/docs/about-claude/pricing
PRICING = {
    # Fable/Mythos 5 share one price point (5m cache write = 1.25x base input).
    "claude-fable-5": {"input": 10.00, "output": 50.00, "cache_write": 12.50, "cache_read": 1.00},
    "claude-mythos-5": {"input": 10.00, "output": 50.00, "cache_write": 12.50, "cache_read": 1.00},
    "claude-opus-4-8": {"input": 5.00, "output": 25.00, "cache_write": 6.25, "cache_read": 0.50},
    "claude-opus-4-7": {"input": 5.00, "output": 25.00, "cache_write": 6.25, "cache_read": 0.50},
    "claude-opus-4-6": {"input": 5.00, "output": 25.00, "cache_write": 6.25, "cache_read": 0.50},
    "claude-opus-4-5-20251101": {"input": 5.00, "output": 25.00, "cache_write": 6.25, "cache_read": 0.50},
    "claude-sonnet-4-6": {"input": 3.00, "output": 15.00, "cache_write": 3.75, "cache_read": 0.30},
    "claude-haiku-4-5-20251001": {"input": 1.00, "output": 5.00, "cache_write": 1.25, "cache_read": 0.10},
    # Synthetic messages are generated locally (no API call) — zero cost.
    "<synthetic>": {"input": 0.0, "output": 0.0, "cache_write": 0.0, "cache_read": 0.0},
}

LEDGER_VERSION = 1

# ── Live pricing: cached fetch from the LiteLLM price table, static fallback ──
# Anthropic publishes no machine-readable price API, so we use the community
# LiteLLM table (verified against platform.claude.com/docs/.../pricing). Fetched
# weekly into pricing-cache.json; any network/parse failure falls back to the
# static PRICING table above. Fetched entries take precedence so new model IDs
# get priced without code edits.
LITELLM_PRICE_URL = (
    "https://raw.githubusercontent.com/BerriAI/litellm/main/"
    "model_prices_and_context_window.json"
)
PRICING_CACHE_VERSION = 1
PRICING_CACHE_MAX_AGE_DAYS = 7
# Regional/multi-region endpoints carry a 10% premium over the global Claude API
# rate, so we prefer the bare (global) entry when both exist.
_REGION_PREFIXES = ("us.", "eu.", "au.", "jp.", "apac.", "global.")
_PROVIDER_PREFIXES = ("anthropic.", "bedrock/", "vertex_ai/", "vertex_ai-anthropic_models/")


def _normalize_model_key(key):
    """Strip provider/region prefixes and Bedrock version suffixes to a bare id,
    e.g. 'us.anthropic.claude-opus-4-8-v1:0' -> 'claude-opus-4-8'."""
    k = key.lower()
    changed = True
    while changed:
        changed = False
        for p in _REGION_PREFIXES + _PROVIDER_PREFIXES:
            if k.startswith(p):
                k = k[len(p):]
                changed = True
    # Drop a trailing Bedrock version suffix: -vN:N, -vN, or :N (any version).
    return re.sub(r"(-v\d+)?:\d+$|-v\d+$", "", k)


def parse_litellm_table(data):
    """Convert the LiteLLM JSON into {normalized_model: per-million price dict}.
    Prefers global (non-regional) source keys over their 10%-premium regional twins."""
    prices = {}
    from_direct = {}  # normalized id -> was the source key global (preferred)?
    for key, val in data.items():
        if not isinstance(val, dict) or "claude" not in key.lower():
            continue
        inp = val.get("input_cost_per_token")
        out = val.get("output_cost_per_token")
        if inp is None or out is None:
            continue
        norm = _normalize_model_key(key)
        is_global = not key.lower().startswith(_REGION_PREFIXES)
        if norm in prices and from_direct.get(norm) and not is_global:
            continue  # keep the global entry already stored
        prices[norm] = {
            "input": inp * 1_000_000,
            "output": out * 1_000_000,
            "cache_write": (val.get("cache_creation_input_token_cost") or 0.0) * 1_000_000,
            "cache_read": (val.get("cache_read_input_token_cost") or 0.0) * 1_000_000,
        }
        from_direct[norm] = is_global
    return prices


def load_pricing(claude_dir):
    """Return fetched {normalized_model: price} from cache or a fresh LiteLLM
    pull. Empty dict on any failure (callers fall back to static PRICING)."""
    cache = claude_dir / "pricing-cache.json"
    today = datetime.now().strftime("%Y-%m-%d")

    if cache.exists():
        try:
            cdata = json.loads(cache.read_text())
            if cdata.get("version") == PRICING_CACHE_VERSION:
                fetched_date = cdata.get("fetched_date", "")
                try:
                    age = (datetime.strptime(today, "%Y-%m-%d")
                           - datetime.strptime(fetched_date, "%Y-%m-%d")).days
                except ValueError:
                    age = None
                if age is not None and 0 <= age < PRICING_CACHE_MAX_AGE_DAYS:
                    return cdata.get("prices", {})
        except (json.JSONDecodeError, OSError):
            pass

    try:
        req = urllib.request.Request(LITELLM_PRICE_URL, headers={"User-Agent": "claude-cost"})
        with urllib.request.urlopen(req, timeout=10) as resp:
            data = json.load(resp)
        prices = parse_litellm_table(data)
        if not prices:
            raise ValueError("no Claude models in table")
        try:
            tmp = cache.with_suffix(".tmp")
            tmp.write_text(json.dumps(
                {"version": PRICING_CACHE_VERSION, "fetched_date": today, "prices": prices},
                indent=2,
            ))
            tmp.rename(cache)
        except OSError:
            pass
        print(f"  Pricing refreshed from LiteLLM ({len(prices)} models).", file=sys.stderr)
        return prices
    except Exception as e:  # network, parse, anything — fall back to static table
        print(f"  Note: live pricing unavailable ({e}); using built-in table.", file=sys.stderr)
        return {}


def resolve_price(model, fetched):
    """Find a price for a session model id, trying fetched data then the static
    PRICING table, with [1m]-suffix and trailing-date fallbacks."""
    candidates = [model]
    if "[" in model:
        candidates.append(model.split("[", 1)[0])
    for c in list(candidates):
        m = re.match(r"^(.*)-\d{8}$", c)  # strip a trailing -YYYYMMDD date variant
        if m:
            candidates.append(m.group(1))

    for c in candidates:
        nc = _normalize_model_key(c)
        if nc in fetched:
            return fetched[nc]
    for c in candidates:
        if c in PRICING:
            return PRICING[c]
        nc = _normalize_model_key(c)
        if nc in PRICING:
            return PRICING[nc]
    return None


def parse_args():
    daily = False
    monthly = False
    all_time = False
    month = None

    for arg in sys.argv[1:]:
        if arg == "--daily":
            daily = True
        elif arg == "--monthly":
            monthly = True
        elif arg == "--all":
            all_time = True
        elif arg in ("--help", "-h"):
            print(__doc__.strip())
            sys.exit(0)
        elif len(arg) == 7 and arg[:4].isdigit() and arg[4] == "-":
            month = arg
        else:
            print(f"Unknown argument: {arg}", file=sys.stderr)
            sys.exit(1)

    if monthly:
        if month:
            print("--monthly spans all data; remove the year-month argument.", file=sys.stderr)
            sys.exit(1)
        all_time = True  # monthly view always spans all data

    if not month and not all_time:
        month = datetime.now().strftime("%Y-%m")

    return daily, monthly, all_time, month


# ── Ledger: persistent daily aggregates ──

def ledger_path(claude_dir):
    return claude_dir / "usage-ledger.json"


def load_ledger(path):
    """Load ledger as dict keyed by (date, model) -> token counts."""
    if not path.exists():
        return {}, None
    try:
        with open(path) as f:
            data = json.load(f)
        if data.get("version") != LEDGER_VERSION:
            return {}, None
        last_scan = data.get("last_scan_date")
        entries = {}
        for row in data.get("daily", []):
            key = (row["date"], row["model"])
            entries[key] = {
                "input": row["input"],
                "output": row["output"],
                "cache_write": row["cache_write"],
                "cache_read": row["cache_read"],
                "msgs": row["msgs"],
            }
        return entries, last_scan
    except (json.JSONDecodeError, KeyError, OSError):
        return {}, None


def save_ledger(path, entries, scan_date):
    """Save aggregated daily data to ledger."""
    daily = []
    for (date, model), t in sorted(entries.items()):
        daily.append({
            "date": date,
            "model": model,
            "input": t["input"],
            "output": t["output"],
            "cache_write": t["cache_write"],
            "cache_read": t["cache_read"],
            "msgs": t["msgs"],
        })
    data = {
        "version": LEDGER_VERSION,
        "last_scan_date": scan_date,
        "daily": daily,
    }
    tmp = path.with_suffix(".tmp")
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    tmp.rename(path)


def needs_live_scan(month, all_time, last_scan):
    """Determine if we need to scan live JSONL files."""
    today = datetime.now().strftime("%Y-%m-%d")
    today_month = today[:7]

    # No ledger yet — must scan
    if last_scan is None:
        return True

    # --all or current month: scan if we haven't scanned today
    if all_time or month == today_month:
        return last_scan != today

    # Past month: ledger has it if we ever scanned after that month ended
    # e.g. asking for 2026-03, ledger last scanned 2026-04-01 or later
    try:
        year, mon = int(month[:4]), int(month[5:7])
        if mon == 12:
            first_of_next = f"{year + 1}-01-01"
        else:
            first_of_next = f"{year}-{mon + 1:02d}-01"
        return last_scan < first_of_next
    except (ValueError, IndexError):
        return True


# ── JSONL scanning ──

def process_jsonl(path, deduped):
    """Parse a JSONL file, keeping most complete entry per requestId."""
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    obj = json.loads(line)
                except json.JSONDecodeError:
                    continue
                msg = obj.get("message", {})
                usage = msg.get("usage")
                req_id = obj.get("requestId")
                if not usage or not req_id:
                    continue
                ts = obj.get("timestamp", "")
                date = ts.split("T")[0] if "T" in ts else ""
                entry = {
                    "model": msg.get("model", "unknown"),
                    "date": date,
                    "input": usage.get("input_tokens", 0),
                    "output": usage.get("output_tokens", 0),
                    "cache_write": usage.get("cache_creation_input_tokens", 0),
                    "cache_read": usage.get("cache_read_input_tokens", 0),
                }
                prev = deduped.get(req_id)
                if prev is None or entry["output"] > prev["output"]:
                    deduped[req_id] = entry
    except (OSError, UnicodeDecodeError):
        pass


def scan_live_sessions(projects_dir):
    """Scan all JSONL files and return daily aggregates."""
    jsonl_files = list(projects_dir.rglob("*.jsonl"))
    if not jsonl_files:
        return {}

    print(f"Scanning {len(jsonl_files)} session files...", file=sys.stderr)

    deduped = {}
    for i, path in enumerate(jsonl_files):
        process_jsonl(path, deduped)
        if (i + 1) % 200 == 0:
            print(f"  ...{i + 1}/{len(jsonl_files)}", file=sys.stderr)

    print(f"  {len(deduped)} unique API calls found.", file=sys.stderr)

    # Aggregate by (date, model)
    agg = defaultdict(lambda: {"input": 0, "output": 0, "cache_write": 0, "cache_read": 0, "msgs": 0})
    for entry in deduped.values():
        key = (entry["date"], entry["model"])
        a = agg[key]
        a["input"] += entry["input"]
        a["output"] += entry["output"]
        a["cache_write"] += entry["cache_write"]
        a["cache_read"] += entry["cache_read"]
        a["msgs"] += 1

    return dict(agg)


# ── Display ──

def compute_cost(model, tokens, pricing=None):
    p = resolve_price(model, pricing or {})
    if p is None:
        return None
    return (
        tokens["input"] * p["input"]
        + tokens["output"] * p["output"]
        + tokens["cache_write"] * p["cache_write"]
        + tokens["cache_read"] * p["cache_read"]
    ) / 1_000_000


def fmt_tokens(n):
    if n >= 1_000_000_000:
        return f"{n / 1_000_000_000:.1f}B"
    if n >= 1_000_000:
        return f"{n / 1_000_000:.1f}M"
    if n >= 1_000:
        return f"{n / 1_000:.1f}k"
    return str(n)


def display(agg, daily, all_time, month, monthly=False, pricing=None):
    """Filter and display aggregated data."""
    pricing = pricing or {}
    # Drop zero-priced pseudo-models (e.g. <synthetic>) up-front so they don't
    # contribute to bucketing, the empty-data check, totals, or subtotals.
    def _is_zero_priced(model):
        p = resolve_price(model, pricing)
        return p is not None and p["input"] == 0
    agg = {k: v for k, v in agg.items() if not _is_zero_priced(k[1])}

    # Filter
    if monthly:
        # Re-bucket daily records into months (keeping the per-model split)
        # and render with the per-row layout (reuses the --daily path).
        bucketed = defaultdict(lambda: {"input": 0, "output": 0, "cache_write": 0, "cache_read": 0, "msgs": 0})
        for (date, model), t in agg.items():
            mkey = date[:7] if date else "unknown"
            b = bucketed[(mkey, model)]
            for field in ("input", "output", "cache_write", "cache_read", "msgs"):
                b[field] += t[field]
        agg = dict(bucketed)
        daily = True
    elif not all_time:
        agg = {k: v for k, v in agg.items() if k[0].startswith(month)}

    if not agg:
        if monthly:
            period = "all time (monthly)"
        else:
            period = "all time" if all_time else month
        print(f"\nNo usage data found for {period}.")
        return

    # Collapse to model-only keys if not daily
    if not daily:
        collapsed = defaultdict(lambda: {"input": 0, "output": 0, "cache_write": 0, "cache_read": 0, "msgs": 0})
        for (date, model), t in agg.items():
            key = ("", model)
            for field in ("input", "output", "cache_write", "cache_read", "msgs"):
                collapsed[key][field] += t[field]
        rows = sorted(collapsed.items())
    else:
        rows = sorted(agg.items())

    # Header
    col_label = "Month" if monthly else "Date"
    if daily:
        hdr = f"\n{col_label:<12} {'Model':<28} {'Input':>10} {'Output':>10} {'Cache Wr':>10} {'Cache Rd':>10} {'Msgs':>6} {'Cost':>10}"
    else:
        hdr = f"\n{'Model':<28} {'Input':>10} {'Output':>10} {'Cache Wr':>10} {'Cache Rd':>10} {'Msgs':>6} {'Cost':>10}"
    sep = "-" * len(hdr.strip())

    print(hdr)
    print(sep)

    total_cost = 0
    unknown_models = set()
    totals = {"input": 0, "output": 0, "cache_write": 0, "cache_read": 0, "msgs": 0}

    def breakdown_row(c1, c2, t, cost_str):
        return (
            f"{c1:<12} {c2:<28} {fmt_tokens(t['input']):>10} {fmt_tokens(t['output']):>10} "
            f"{fmt_tokens(t['cache_write']):>10} {fmt_tokens(t['cache_read']):>10} {t['msgs']:>6} {cost_str}"
        )

    if daily:
        # Group rows by date/month; close each group with a subtotal + splitter.
        cur_key = None
        grp = {"input": 0, "output": 0, "cache_write": 0, "cache_read": 0, "msgs": 0}
        grp_cost = 0.0
        grp_rows = 0

        def flush_group():
            nonlocal grp, grp_cost, grp_rows
            if grp_rows > 1:
                print(breakdown_row("", "(subtotal)", grp, f"${grp_cost:>8.2f}"))
            print(sep)
            grp = {"input": 0, "output": 0, "cache_write": 0, "cache_read": 0, "msgs": 0}
            grp_cost = 0.0
            grp_rows = 0

        for (date, model), t in rows:
            cost = compute_cost(model, t, pricing)
            cost_str = f"${cost:>8.2f}" if cost is not None else "  unknown"
            if cost is None:
                unknown_models.add(model)
                cost = 0
            if cur_key is not None and date != cur_key:
                flush_group()
            cur_key = date
            total_cost += cost
            grp_cost += cost
            grp_rows += 1
            for k in totals:
                totals[k] += t[k]
                grp[k] += t[k]
            print(breakdown_row(date, model, t, cost_str))
        if cur_key is not None:
            flush_group()

        print(breakdown_row("TOTAL", "", totals, f"${total_cost:>8.2f}"))
    else:
        for (date, model), t in rows:
            cost = compute_cost(model, t, pricing)
            cost_str = f"${cost:>8.2f}" if cost is not None else "  unknown"
            if cost is None:
                unknown_models.add(model)
                cost = 0
            total_cost += cost
            for k in totals:
                totals[k] += t[k]
            print(
                f"{model:<28} {fmt_tokens(t['input']):>10} {fmt_tokens(t['output']):>10} "
                f"{fmt_tokens(t['cache_write']):>10} {fmt_tokens(t['cache_read']):>10} {t['msgs']:>6} {cost_str}"
            )

        print(sep)
        print(
            f"{'TOTAL':<28} {fmt_tokens(totals['input']):>10} {fmt_tokens(totals['output']):>10} "
            f"{fmt_tokens(totals['cache_write']):>10} {fmt_tokens(totals['cache_read']):>10} {totals['msgs']:>6} ${total_cost:>8.2f}"
        )

    if monthly:
        period = "All-time (monthly)"
    else:
        period = "All-time" if all_time else month
    print(f"\n  {period} estimated cost: ${total_cost:.2f}")
    print("  (Based on API pricing — actual subscription cost may differ)")
    if unknown_models:
        print(f"  Warning: {len(unknown_models)} unknown model(s) excluded from cost: {', '.join(sorted(unknown_models))}")
    print()


# ── Main ──

def main():
    daily, monthly, all_time, month = parse_args()

    claude_dir = Path(os.environ.get("CLAUDE_DIR", Path.home() / ".claude"))
    projects_dir = claude_dir / "projects"
    lpath = ledger_path(claude_dir)

    # Load cached data
    ledger, last_scan = load_ledger(lpath)

    if needs_live_scan(month, all_time, last_scan):
        if not projects_dir.is_dir():
            if not ledger:
                print(f"No Claude Code projects directory found at {projects_dir}", file=sys.stderr)
                sys.exit(1)
        else:
            live = scan_live_sessions(projects_dir)

            # Merge: live data overwrites ledger for any day it covers,
            # since live is computed from full JSONL with deduplication.
            # Ledger keeps days no longer in live (expired sessions).
            live_dates = {date for date, _ in live}
            merged = {k: v for k, v in ledger.items() if k[0] not in live_dates}
            merged.update(live)
            ledger = merged

            # Save updated ledger
            today = datetime.now().strftime("%Y-%m-%d")
            try:
                save_ledger(lpath, ledger, today)
                print(f"  Ledger updated ({len(ledger)} daily records).", file=sys.stderr)
            except OSError as e:
                print(f"  Warning: could not save ledger: {e}", file=sys.stderr)
    else:
        print("Using cached ledger (no live scan needed).", file=sys.stderr)

    pricing = load_pricing(claude_dir)
    display(ledger, daily, all_time, month, monthly, pricing)


if __name__ == "__main__":
    main()
